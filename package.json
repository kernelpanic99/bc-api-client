{
    "name": "bc-api-client",
    "version": "2.0.1",
    "description": "A client for the BigCommerce management API and app authentication",
    "main": "dist/index.mjs",
    "types": "dist/index.d.mts",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "default": "./dist/index.mjs"
        },
        "./package.json": "./package.json"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/kernelpanic99/bc-api-client"
    },
    "homepage": "https://github.com/kernelpanic99/bc-api-client",
    "bugs": {
        "url": "https://github.com/kernelpanic99/bc-api-client/issues"
    },
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "test": "vitest",
        "lint": "biome check --fix",
        "build": "tsdown",
        "typecheck": "node node_modules/typescript-native/bin/tsc --noEmit",
        "prepublishOnly": "pnpm build",
        "version": "git add -A src",
        "postversion": "git push && git push --tags",
        "qa": "concurrently 'biome check' 'node node_modules/typescript-native/bin/tsc --noEmit' 'vitest --run' 'typedoc --emit none' --kill-others-on-fail",
        "doc": "typedoc"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "keywords": [
        "bigcommerce",
        "api",
        "client",
        "typescript",
        "jwt",
        "authentication"
    ],
    "publishConfig": {
        "access": "public"
    },
    "author": "Arthur Nikolaienko",
    "license": "MIT",
    "devDependencies": {
        "@arethetypeswrong/core": "0.18.5",
        "@aws-lambda-powertools/logger": "2.35.0",
        "@biomejs/biome": "2.5.13",
        "@types/node": "22.20.2",
        "concurrently": "10.0.5",
        "lefthook": "2.1.12",
        "pino": "10.3.1",
        "tsdown": "0.23.0",
        "typedoc": "0.28.20",
        "typedoc-plugin-markdown": "4.13.0",
        "typescript": "6.0.3",
        "typescript-native": "npm:typescript@7.0.2",
        "vitest": "5.0.0",
        "zod": "4.6.2"
    },
    "dependencies": {
        "jose": "6.2.12",
        "ky": "2.1.0",
        "p-limit": "7.3.2"
    }
}
